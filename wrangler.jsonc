{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "liming-worldmap",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/tools/*/assets/*"]
  },
  // 互传（Space）和登录限流（Limiter）已删除：v2 迁移会在部署时连同里面存的数据一起删掉
  // 小芯的任务看护（XinTaskSupervisor）2026-11-26 随小芯、天启一起删：v4 迁移连同里面存的待送达消息一起删（站长同意）
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Space", "Limiter"] },
    { "tag": "v2", "deleted_classes": ["Space", "Limiter"] },
    { "tag": "v3", "new_sqlite_classes": ["XinTaskSupervisor"] },
    { "tag": "v4", "deleted_classes": ["XinTaskSupervisor"] }
  ],
  "observability": { "enabled": false },
  // 定时任务已关（2026-11-26 站长：小芯、天启停用，每日清单不要了）。以前是北京 8:55 叫醒电脑、9:10 / 21:10 让小芯按清单做一遍。
  // 写成空数组：发布时 Cloudflare 会撤掉已有的定时触发。
  "triggers": { "crons": [] },
  "routes": [
    { "pattern": "liming-work.com", "custom_domain": true },
    { "pattern": "www.liming-work.com", "custom_domain": true }
  ],
  // 测试站：wrangler deploy --env staging
  // 单独的 Worker，不绑正式域名，只用 *.workers.dev 地址
  "env": {
    "staging": {
      "name": "liming-hub-staging",
      "routes": [],
      "workers_dev": true,
      "triggers": { "crons": [] },   // 测试站不跑定时任务
      "assets": {
        "directory": "./site",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/tools/*/assets/*"]
      }
    }
  }
}
