{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "liming-worldmap",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/tools/*/assets/*", "/xin/vm-*"]
  },
  // 互传（Space）和登录限流（Limiter）已删除：v2 迁移会在部署时连同里面存的数据一起删掉
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Space", "Limiter"] },
    { "tag": "v2", "deleted_classes": ["Space", "Limiter"] },
    { "tag": "v3", "new_sqlite_classes": ["XinTaskSupervisor"] }
  ],
  "observability": { "enabled": false },
  "durable_objects": { "bindings": [{ "name": "XIN_TASK_SUPERVISOR", "class_name": "XinTaskSupervisor" }] },
  // 小芯聊天（src/xin.js）：云电脑的名字；登录每个 IP 每分钟最多试 5 次
  // 密钥 OWNER_PASSWORD、INSTABOX_API_KEY 由 Actions 从 GitHub Secrets 写进正式站（XIN_OWNER_PASSWORD、XIN_INSTABOX_API_KEY），测试站不配，功能关着
  // 小芯内核第 1 步（docs/xin-kernel-design.md）：XIN_TRANSPORT=kernel 走电脑上常驻内核的私有端口（不写或写 exec 就照旧走 InstaBox exec）；
  // XIN_INBOX=1 发消息先存进待送达再送。回滚优先改这两个开关；整版回滚前先确认待送达里没有没送完的消息。
  // 第 2 批（docs/superpowers/plans/2026-11-15-xin-state-owner-switch.md）：XIN_STATE_OWNER=kernel 时小芯的状态由电脑上常驻的状态进程管
  // （内核外壳拉起、看住，操作不再起控制器进程）；改成 legacy 发版，外壳就让它排空、交回旧方式。部署代号由 Durable Object 按下面的版本信息发。
  "vars": { "XIN_MACHINE": "li", "XIN_TRANSPORT": "kernel", "XIN_INBOX": "1", "XIN_STATE_OWNER": "kernel" },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "ratelimits": [{ "name": "XIN_LOGIN_LIMIT", "namespace_id": "1801", "simple": { "limit": 5, "period": 60 } }],
  // 小芯的每日任务（UTC）：0:55 = 北京 8:55 叫醒电脑（网关 9:00 自己签到）；1:10、13:10 = 北京 9:10、21:10 按清单做一遍
  "triggers": { "crons": ["55 0 * * *", "10 1,13 * * *"] },
  "routes": [
    { "pattern": "liming-work.com", "custom_domain": true },
    { "pattern": "www.liming-work.com", "custom_domain": true }
  ],
  // 测试站：wrangler deploy --env staging
  // 单独的 Worker，不绑正式域名，只用 *.workers.dev 地址
  "env": {
    "staging": {
      "name": "liming-hub-staging",
      "routes": [],
      "workers_dev": true,
      "durable_objects": { "bindings": [{ "name": "XIN_TASK_SUPERVISOR", "class_name": "XinTaskSupervisor" }] },
      "vars": { "XIN_MACHINE": "li" },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "ratelimits": [{ "name": "XIN_LOGIN_LIMIT", "namespace_id": "1802", "simple": { "limit": 5, "period": 60 } }],
      "triggers": { "crons": [] },   // 测试站不跑定时任务
      "assets": {
        "directory": "./site",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/tools/*/assets/*", "/xin/vm-*"]
      }
    }
  }
}
