 .panel{position:absolute;inset:0;background:var(--bg);visibility:hidden;pointer-events:none;
   clip-path:inset(0 round 0);-webkit-clip-path:inset(0 round 0)}
 .panel.show{visibility:visible;pointer-events:auto}
+/* 关闭后整块面板（含启动页/返回键）必须立刻不可见：子元素若带 visibility 过渡，会在父级 hidden 时仍“可见”0.5s，
+   iOS WebKit 对这种「隐藏父层里的可见子层」不再更新合成层，会把关闭动画最后一帧（卡片位置的裁切残影）冻结在首页上 */
+.panel:not(.show) .splash,.panel:not(.show) .back{visibility:hidden!important;transition:none!important;animation:none!important}
 .panel.anim{will-change:clip-path,transform;transition:clip-path .58s var(--ease),-webkit-clip-path .58s var(--ease),transform .45s var(--ease),opacity .45s var(--ease)}
