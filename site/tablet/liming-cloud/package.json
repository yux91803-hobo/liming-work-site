{
  "name": "liming-cloud",
  "version": "0.1.0",
  "private": true,
  "description": "Liming 工具箱自用：让平板本机 AI 按需派发、追踪与恢复运行在 li / li2 云电脑上的任务。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "云电脑",
      "en": "Cloud"
    },
    "icon": "cloud",
    "contributes": {
      "composer.strip": [
        {
          "id": "cloud-status",
          "icon": "cloud",
          "panel": "cloud-tasks"
        }
      ],
      "panels": [
        {
          "id": "cloud-tasks",
          "title": {
            "zh": "云端任务",
            "en": "Cloud tasks"
          },
          "icon": "cloud",
          "placement": [
            "session.tab",
            "chat.panel"
          ],
          "presentation": "sheet"
        }
      ]
    }
  }
}
