{
  "name": "liming-lease",
  "version": "0.1.0",
  "private": true,
  "description": "Liming 工具箱自用：装在 li、li2 的 dsh web 配置里，平板派来的活在跑时持有 InstaBox 活动租约，空闲后释放。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": ["lib", "cordis.patch.yml"],
  "engines": { "node": ">=22.19", "dsh": ">=0.2.1-rc.2 <0.3.0-0" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } }
}
